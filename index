<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Loving Longmont | Discover • Connect • Support Local</title>

<meta name="description"
content="Loving Longmont connects residents and visitors with local businesses, events, things to do, jobs, community resources and everything we love about Longmont, Colorado.">

<style>

:root {
  --green: #285640;
  --dark-green: #173f30;
  --sage: #dfe8df;
  --light-sage: #eef2eb;
  --cream: #f8f5ed;
  --white: #ffffff;
  --text: #31443a;
  --muted: #66736b;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: Arial, Helvetica, sans-serif;
  background: var(--cream);
  color: var(--text);
  line-height: 1.6;
}

a {
  color: inherit;
}


/* ================================
   NAVIGATION
================================ */

header {
  background: rgba(255,255,255,.97);
  position: sticky;
  top: 0;
  z-index: 1000;
  border-bottom: 1px solid #e6e6e6;
}

.nav {
  max-width: 1200px;
  margin: auto;
  min-height: 76px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 25px;
}

.logo {
  text-decoration: none;
  color: var(--dark-green);
}

.logo-title {
  font-family: Georgia, serif;
  font-size: 27px;
  font-weight: bold;
}

.logo-sub {
  display: block;
  font-size: 10px;
  letter-spacing: 2.5px;
  text-transform: uppercase;
  color: var(--green);
}

.nav-links {
  display: flex;
  gap: 25px;
  align-items: center;
}

.nav-links a {
  text-decoration: none;
  color: var(--text);
  font-size: 14px;
  font-weight: 600;
}

.nav-links a:hover {
  color: var(--green);
}

.nav-button {
  background: var(--green);
  color: white !important;
  padding: 10px 17px;
  border-radius: 7px;
}


/* ================================
   HERO
================================ */

.hero {
  min-height: 580px;

  /*
  When you upload your Longmont header photo to GitHub,
  change this to:
  background-image:
    linear-gradient(rgba(18,52,39,.25), rgba(18,52,39,.55)),
    url("images/longmont-hero.jpg");
  */

  background:
    linear-gradient(rgba(20,60,44,.18), rgba(20,60,44,.55)),
    linear-gradient(135deg, #a9c1b0, #4c7962);

  background-size: cover;
  background-position: center;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: white;
  padding: 60px 25px;
}

.hero-content {
  max-width: 850px;
}

.hero-small {
  text-transform: uppercase;
  letter-spacing: 5px;
  font-size: 14px;
  font-weight: bold;
}

.hero h1 {
  font-family: Georgia, serif;
  font-size: clamp(48px, 8vw, 82px);
  line-height: 1.05;
  margin: 10px 0 15px;
}

.hero-tagline {
  font-size: 21px;
  letter-spacing: 3px;
  margin-bottom: 20px;
}

.hero-description {
  font-size: 18px;
  max-width: 700px;
  margin: auto;
  line-height: 1.7;
}

.hero-buttons {
  margin-top: 32px;
  display: flex;
  justify-content: center;
  gap: 14px;
  flex-wrap: wrap;
}

.button {
  display: inline-block;
  padding: 14px 25px;
  border-radius: 7px;
  text-decoration: none;
  font-weight: bold;
}

.button-light {
  background: white;
  color: var(--dark-green);
}

.button-outline {
  border: 2px solid white;
  color: white;
}


/* ================================
   INTRO
================================ */

.intro {
  text-align: center;
  max-width: 850px;
  margin: auto;
  padding: 75px 25px 55px;
}

.eyebrow {
  color: var(--green);
  text-transform: uppercase;
  letter-spacing: 4px;
  font-size: 13px;
  font-weight: bold;
}

.intro h2,
.section-title {
  font-family: Georgia, serif;
  color: var(--dark-green);
  font-size: 39px;
  line-height: 1.2;
  margin: 10px 0 18px;
}

.intro p {
  font-size: 18px;
  color: var(--muted);
}


/* ================================
   EXPLORE CARDS
================================ */

.explore {
  max-width: 1150px;
  margin: auto;
  padding: 10px 25px 80px;
}

.section-heading {
  text-align: center;
  margin-bottom: 38px;
}

.card-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}

.card {
  background: white;
  padding: 35px 23px;
  border-radius: 16px;
  text-align: center;
  text-decoration: none;
  box-shadow: 0 5px 22px rgba(0,0,0,.06);
  transition: .2s ease;
}

.card:hover {
  transform: translateY(-5px);
  box-shadow: 0 10px 28px rgba(0,0,0,.11);
}

.card-icon {
  font-size: 37px;
  margin-bottom: 15px;
}

.card h3 {
  font-family: Georgia, serif;
  color: var(--dark-green);
  margin: 0 0 8px;
  font-size: 21px;
}

.card p {
  color: var(--muted);
  font-size: 14px;
  margin: 0;
}


/* ================================
   THIS WEEK
================================ */

.this-week {
  background: var(--light-sage);
  padding: 75px 25px;
}

.week-container {
  max-width: 1100px;
  margin: auto;
}

.week-header {
  text-align: center;
  margin-bottom: 40px;
}

.week-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 22px;
}

.week-item {
  background: white;
  border-radius: 14px;
  padding: 28px;
}

.week-category {
  color: var(--green);
  font-size: 12px;
  font-weight: bold;
  letter-spacing: 2px;
  text-transform: uppercase;
}

.week-item h3 {
  font-family: Georgia, serif;
  color: var(--dark-green);
  margin: 7px 0;
}

.week-item p {
  color: var(--muted);
  font-size: 14px;
}


/* ================================
   BUSINESS SPOTLIGHT
================================ */

.spotlight {
  padding: 80px 25px;
}

.spotlight-container {
  max-width: 1100px;
  margin: auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  background: white;
  border-radius: 20px;
  overflow: hidden;
  box-shadow: 0 8px 30px rgba(0,0,0,.07);
}

.spotlight-image {
  min-height: 390px;
  background:
    linear-gradient(rgba(28,76,55,.12), rgba(28,76,55,.25)),
    #b6c9b9;

  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 70px;
}

.spotlight-content {
  padding: 55px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.spotlight-content h2 {
  font-family: Georgia, serif;
  color: var(--dark-green);
  font-size: 35px;
  margin: 8px 0 15px;
}

.spotlight-content p {
  color: var(--muted);
}

.green-button {
  background: var(--green);
  color: white;
  align-self: flex-start;
  margin-top: 12px;
}


/* ================================
   ASK LOVING LONGMONT
================================ */

.ask {
  background: var(--dark-green);
  color: white;
  text-align: center;
  padding: 80px 25px;
}

.ask-content {
  max-width: 750px;
  margin: auto;
}

.ask h2 {
  font-family: Georgia, serif;
  font-size: 40px;
  margin: 8px 0 15px;
}

.ask p {
  color: #e0e9e2;
  font-size: 17px;
}


/* ================================
   COMMUNITY SUBMISSIONS
================================ */

.submit-section {
  padding: 80px 25px;
  text-align: center;
}

.submit-container {
  max-width: 950px;
  margin: auto;
}

.submit-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  margin-top: 35px;
}

.submit-card {
  background: var(--light-sage);
  padding: 30px 20px;
  border-radius: 14px;
}

.submit-card span {
  font-size: 32px;
}

.submit-card h3 {
  color: var(--dark-green);
  font-family: Georgia, serif;
  margin: 10px 0;
}


/* ================================
   FOOTER
================================ */

footer {
  background: #163d2e;
  color: white;
  padding: 55px 25px 22px;
}

.footer-container {
  max-width: 1100px;
  margin: auto;
  display: grid;
  grid-template-columns: 2fr 1fr 1.5fr;
  gap: 45px;
}

.footer-brand h2 {
  font-family: Georgia, serif;
  margin: 0;
  font-size: 28px;
}

.footer-tagline {
  letter-spacing: 2px;
  text-transform: uppercase;
  font-size: 11px;
  margin: 8px 0 15px;
}

.footer-text {
  color: #dce6df;
  max-width: 420px;
  font-size: 14px;
}

.footer-heading {
  text-transform: uppercase;
  letter-spacing: 2px;
  font-size: 13px;
  font-weight: bold;
  margin-bottom: 15px;
}

.footer-links a {
  display: block;
  text-decoration: none;
  color: #dce6df;
  margin: 8px 0;
  font-size: 14px;
}

.footer-links a:hover {
  color: white;
}

.footer-email {
  color: white;
  text-decoration: none;
  font-weight: bold;
}

.footer-bottom {
  max-width: 1100px;
  margin: 35px auto 0;
  padding-top: 20px;
  border-top: 1px solid rgba(255,255,255,.2);
  text-align: center;
  font-size: 12px;
  color: #cbd8cf;
}


/* ================================
   MOBILE
================================ */

@media (max-width: 900px) {

  .nav-links {
    display: none;
  }

  .card-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .week-grid {
    grid-template-columns: 1fr;
  }

  .spotlight-container {
    grid-template-columns: 1fr;
  }

  .submit-grid {
    grid-template-columns: 1fr;
  }

  .footer-container {
    grid-template-columns: 1fr;
  }

}

@media (max-width: 550px) {

  .card-grid {
    grid-template-columns: 1fr;
  }

  .hero {
    min-height: 520px;
  }

  .hero-tagline {
    font-size: 15px;
  }

  .spotlight-content {
    padding: 35px 25px;
  }

}

</style>
</head>


