<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Loving Longmont | People • Places • Possibilities</title>

  <meta name="description"
        content="Loving Longmont is your community guide to local businesses, events, places, jobs, stories and everything we love about Longmont, Colorado.">

  <style>

    :root {
      --navy: #062b4c;
      --red: #c4101b;
      --cream: #fff8ed;
      --soft-cream: #f7f2e9;
      --sage: #e8eee8;
      --green: #294f3d;
      --text: #24333b;
      --muted: #68767c;
      --white: #ffffff;
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      background: var(--soft-cream);
      color: var(--text);
      line-height: 1.6;
    }

    img {
      max-width: 100%;
      display: block;
    }

    a {
      color: inherit;
    }


    /* =========================
       NAVIGATION
    ========================= */

    header {
      background: rgba(255,255,255,.98);
      border-bottom: 1px solid #e5e5e5;
      position: sticky;
      top: 0;
      z-index: 1000;
    }

    .nav {
      max-width: 1250px;
      margin: auto;
      padding: 10px 24px;
      min-height: 80px;

      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 30px;
    }

    .brand {
      display: flex;
      align-items: center;
      text-decoration: none;
    }

    .brand img {
      width: 210px;
      max-height: 65px;
      object-fit: contain;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 24px;
    }

    .nav-links a {
      text-decoration: none;
      font-size: 14px;
      font-weight: 700;
      color: var(--navy);
    }

    .nav-links a:hover {
      color: var(--red);
    }

    .contact-button {
      background: var(--navy);
      color: white !important;
      padding: 10px 17px;
      border-radius: 7px;
    }


    /* =========================
       HERO HEADER
    ========================= */

    .hero {
      position: relative;
      min-height: 640px;

      background-image:
        linear-gradient(
          to bottom,
          rgba(4,36,64,.05),
          rgba(4,36,64,.12)
        ),
        url("images/loving-longmont-header.png");

      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;

      display: flex;
      align-items: flex-end;
    }

    .hero-bottom {
      width: 100%;
      padding: 35px 25px;
      background: linear-gradient(
        to top,
        rgba(6,43,76,.8),
        rgba(6,43,76,0)
      );
    }

    .hero-buttons {
      max-width: 1100px;
      margin: auto;
      display: flex;
      justify-content: center;
      gap: 14px;
      flex-wrap: wrap;
    }

    .button {
      display: inline-block;
      text-decoration: none;
      padding: 14px 24px;
      border-radius: 8px;
      font-weight: 700;
      transition: .2s ease;
    }

    .button-primary {
      background: var(--red);
      color: white;
    }

    .button-primary:hover {
      transform: translateY(-2px);
      background: #a90913;
    }

    .button-light {
      background: white;
      color: var(--navy);
    }

    .button-light:hover {
      transform: translateY(-2px);
    }


    /* =========================
       INTRO
    ========================= */

    .intro {
      background: var(--cream);
      text-align: center;
      padding: 75px 25px 60px;
    }

    .section-inner {
      max-width: 1100px;
      margin: auto;
    }

    .eyebrow {
      text-transform: uppercase;
      letter-spacing: 4px;
      font-size: 12px;
      font-weight: 700;
      color: var(--red);
    }

    .section-title {
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(35px, 5vw, 52px);
      line-height: 1.15;
      color: var(--navy);
      margin: 8px 0 18px;
    }

    .intro p {
      max-width: 820px;
      margin: auto;
      font-size: 18px;
      color: var(--muted);
    }


    /* =========================
       EXPLORE CARDS
    ========================= */

    .explore {
      padding: 75px 25px;
      background: white;
    }

    .section-heading {
      text-align: center;
      margin-bottom: 40px;
    }

    .card-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 22px;
    }

    .card {
      text-decoration: none;
      text-align: center;
      padding: 34px 24px;
      border-radius: 16px;
      background: var(--soft-cream);
      border: 1px solid #ece7dc;
      box-shadow: 0 7px 25px rgba(0,0,0,.05);

      transition: transform .2s ease, box-shadow .2s ease;
    }

    .card:hover {
      transform: translateY(-5px);
      box-shadow: 0 12px 28px rgba(0,0,0,.10);
    }

    .card-icon {
      font-size: 39px;
      margin-bottom: 12px;
    }

    .card h3 {
      font-family: Georgia, serif;
      color: var(--navy);
      margin: 0 0 8px;
      font-size: 22px;
    }

    .card p {
      color: var(--muted);
      font-size: 14px;
      margin: 0;
    }


    /* =========================
       THIS WEEK
    ========================= */

    .this-week {
      padding: 75px 25px;
      background: var(--sage);
    }

    .week-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 22px;
      margin-top: 38px;
    }

    .week-card {
      background: white;
      border-radius: 15px;
      padding: 29px;
      box-shadow: 0 5px 18px rgba(0,0,0,.04);
    }

    .week-label {
      text-transform: uppercase;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 2px;
      color: var(--red);
    }

    .week-card h3 {
      font-family: Georgia, serif;
      color: var(--navy);
      font-size: 22px;
      margin: 7px 0 8px;
    }

    .week-card p {
      color: var(--muted);
      margin-bottom: 0;
    }


    /* =========================
       BUSINESS SPOTLIGHT
    ========================= */

    .spotlight {
      padding: 80px 25px;
      background: var(--cream);
    }

    .spotlight-box {
      max-width: 1100px;
      margin: auto;
      border-radius: 20px;
      overflow: hidden;
      background: white;
      display: grid;
      grid-template-columns: 1fr 1fr;
      box-shadow: 0 10px 35px rgba(0,0,0,.08);
    }

    .spotlight-image {
      min-height: 430px;

      background:
        linear-gradient(
          rgba(6,43,76,.08),
          rgba(6,43,76,.08)
        ),
        url("images/loving-longmont-logo.png");

      background-size: cover;
      background-position: center;
    }

    .spotlight-content {
      padding: 55px;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .spotlight-content h2 {
      font-family: Georgia, serif;
      color: var(--navy);
      font-size: 38px;
      line-height: 1.2;
      margin: 8px 0 15px;
    }

    .spotlight-content p {
      color: var(--muted);
    }


    /* =========================
       COMMUNITY CTA
    ========================= */

    .community {
      background: var(--navy);
      color: white;
      text-align: center;
      padding: 85px 25px;
    }

    .community-inner {
      max-width: 780px;
      margin: auto;
    }

    .community .eyebrow {
      color: #ffc5c8;
    }

    .community h2 {
      font-family: Georgia, serif;
      font-size: clamp(35px, 5vw, 48px);
      margin: 8px 0 15px;
    }

    .community p {
      color: #dfe8ee;
      font-size: 17px;
    }


    /* =========================
       CONTRIBUTE
    ========================= */

    .contribute {
      padding: 80px 25px;
      background: white;
      text-align: center;
    }

    .contribute-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 22px;
      margin-top: 38px;
    }

    .contribute-card {
      background: var(--soft-cream);
      border-radius: 15px;
      padding: 32px 23px;
    }

    .contribute-card span {
      font-size: 37px;
    }

    .contribute-card h3 {
      font-family: Georgia, serif;
      color: var(--navy);
      margin: 10px 0 7px;
    }

    .contribute-card p {
      color: var(--muted);
      font-size: 14px;
    }


    /* =========================
       FOOTER
    ========================= */

    footer {
      background: #041f38;
      color: white;
      padding: 55px 25px 22px;
    }

    .footer-container {
      max-width: 1100px;
      margin: auto;

      display: grid;
      grid-template-columns: 2fr 1fr 1.5fr;
      gap: 45px;
    }

    .footer-brand img {
      width: 250px;
      max-height: 115px;
      object-fit: contain;
      object-position: left center;
      margin-bottom: 15px;
    }

    .footer-tagline {
      text-transform: uppercase;
      font-size: 11px;
      letter-spacing: 2px;
      color: #d4e0e7;
    }

    .footer-text {
      color: #d4e0e7;
      font-size: 14px;
    }

    .footer-heading {
      text-transform: uppercase;
      letter-spacing: 2px;
      font-size: 13px;
      font-weight: 700;
      margin-bottom: 15px;
    }

    .footer-links a {
      display: block;
      color: #d4e0e7;
      text-decoration: none;
      margin: 8px 0;
      font-size: 14px;
    }

    .footer-links a:hover {
      color: white;
    }

    .footer-email {
      color: white;
      text-decoration: none;
      font-weight: 700;
      overflow-wrap: anywhere;
    }

    .footer-bottom {
      max-width: 1100px;
      margin: 35px auto 0;
      padding-top: 20px;
      text-align: center;
      border-top: 1px solid rgba(255,255,255,.2);
      color: #bdccd6;
      font-size: 12px;
    }


    /* =========================
       MOBILE
    ========================= */

    @media (max-width: 950px) {

      .nav-links {
        display: none;
      }

      .hero {
        min-height: 520px;
        background-position: center;
      }

      .card-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .week-grid {
        grid-template-columns: 1fr;
      }

      .spotlight-box {
        grid-template-columns: 1fr;
      }

      .spotlight-image {
        min-height: 350px;
      }

      .contribute-grid {
        grid-template-columns: 1fr;
      }

      .footer-container {
        grid-template-columns: 1fr;
      }

    }

    @media (max-width: 600px) {

      .nav {
        justify-content: center;
      }

      .brand img {
        width: 180px;
      }

      .hero {
        min-height: 430px;
      }

      .card-grid {
        grid-template-columns: 1fr;
      }

      .spotlight-content {
        padding: 38px 25px;
      }

    }

  </style>
</head>


