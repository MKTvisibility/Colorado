<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Contact | Loving Longmont</title>

<meta name="description"
content="Contact Loving Longmont. Submit a Longmont event, local business, community story, photograph, job opportunity or suggestion.">

<style>

:root {
  --green: #285640;
  --dark-green: #173f30;
  --sage: #dfe8df;
  --light-sage: #eef2eb;
  --cream: #f8f5ed;
  --white: #ffffff;
  --text: #31443a;
  --muted: #66736b;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: Arial, Helvetica, sans-serif;
  background: var(--cream);
  color: var(--text);
  line-height: 1.6;
}


/* =========================
   NAVIGATION
========================= */

header {
  background: rgba(255,255,255,.97);
  position: sticky;
  top: 0;
  z-index: 1000;
  border-bottom: 1px solid #e6e6e6;
}

.nav {
  max-width: 1200px;
  margin: auto;
  min-height: 76px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 25px;
}

.logo {
  text-decoration: none;
  color: var(--dark-green);
}

.logo-title {
  font-family: Georgia, serif;
  font-size: 27px;
  font-weight: bold;
}

.logo-sub {
  display: block;
  font-size: 10px;
  letter-spacing: 2.5px;
  text-transform: uppercase;
  color: var(--green);
}

.nav-links {
  display: flex;
  gap: 25px;
  align-items: center;
}

.nav-links a {
  text-decoration: none;
  color: var(--text);
  font-size: 14px;
  font-weight: 600;
}

.nav-links a:hover {
  color: var(--green);
}

.nav-button {
  background: var(--green);
  color: white !important;
  padding: 10px 17px;
  border-radius: 7px;
}


/* =========================
   CONTACT HERO
========================= */

.contact-hero {
  text-align: center;
  padding: 90px 25px 55px;
  background:
    radial-gradient(circle at top left,
      rgba(205,220,205,.55),
      transparent 40%),
    var(--cream);
}

.eyebrow {
  text-transform: uppercase;
  letter-spacing: 4px;
  font-size: 13px;
  font-weight: bold;
  color: var(--green);
}

.contact-hero h1 {
  font-family: Georgia, serif;
  color: var(--dark-green);
  font-size: clamp(42px, 6vw, 65px);
  margin: 8px 0 15px;
}

.contact-hero p {
  max-width: 720px;
  margin: auto;
  color: var(--muted);
  font-size: 18px;
}


/* =========================
   CONTACT BOX
========================= */

.contact-wrapper {
  max-width: 1000px;
  margin: auto;
  padding: 20px 25px 80px;
}

.contact-main {
  background: white;
  border-radius: 20px;
  padding: 50px 35px;
  text-align: center;
  box-shadow: 0 8px 30px rgba(0,0,0,.07);
}

.contact-main h2 {
  font-family: Georgia, serif;
  color: var(--dark-green);
  font-size: 32px;
  margin-top: 0;
}

.contact-main p {
  color: var(--muted);
  max-width: 680px;
  margin-left: auto;
  margin-right: auto;
}

.email-button {
  display: inline-block;
  margin: 15px 0 12px;
  background: var(--green);
  color: white;
  text-decoration: none;
  font-weight: bold;
  padding: 14px 25px;
  border-radius: 8px;
  transition: .2s ease;
}

.email-button:hover {
  background: var(--dark-green);
  transform: translateY(-2px);
}

.email-address {
  display: block;
  color: var(--green);
  font-size: 16px;
}


/* =========================
   SUBMISSION OPTIONS
========================= */

.options {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  margin-top: 40px;
}

.option {
  background: var(--light-sage);
  padding: 32px 22px;
  border-radius: 15px;
}

.option-icon {
  font-size: 35px;
}

.option h3 {
  font-family: Georgia, serif;
  color: var(--dark-green);
  margin: 10px 0 8px;
  font-size: 21px;
}

.option p {
  font-size: 14px;
  margin: 0;
}


/* =========================
   SECOND ROW
========================= */

.more-options {
  max-width: 1000px;
  margin: 25px auto 0;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}

.small-option {
  background: white;
  border: 1px solid #e2e7e2;
  border-radius: 14px;
  padding: 27px 22px;
  text-align: center;
}

.small-option span {
  font-size: 29px;
}

.small-option h3 {
  font-family: Georgia, serif;
  color: var(--dark-green);
  margin: 8px 0;
}

.small-option p {
  color: var(--muted);
  font-size: 14px;
}


/* =========================
   COMMUNITY SECTION
========================= */

.community {
  background: var(--light-sage);
  text-align: center;
  padding: 75px 25px;
}

.community-content {
  max-width: 760px;
  margin: auto;
}

.community h2 {
  font-family: Georgia, serif;
  color: var(--dark-green);
  font-size: 38px;
  margin: 8px 0 15px;
}

.community p {
  color: var(--muted);
  font-size: 17px;
}


/* =========================
   FOOTER
========================= */

footer {
  background: #163d2e;
  color: white;
  padding: 55px 25px 22px;
}

.footer-container {
  max-width: 1100px;
  margin: auto;
  display: grid;
  grid-template-columns: 2fr 1fr 1.5fr;
  gap: 45px;
}

.footer-brand h2 {
  font-family: Georgia, serif;
  margin: 0;
  font-size: 28px;
}

.footer-tagline {
  letter-spacing: 2px;
  text-transform: uppercase;
  font-size: 11px;
  margin: 8px 0 15px;
}

.footer-text {
  color: #dce6df;
  max-width: 420px;
  font-size: 14px;
}

.footer-heading {
  text-transform: uppercase;
  letter-spacing: 2px;
  font-size: 13px;
  font-weight: bold;
  margin-bottom: 15px;
}

.footer-links a {
  display: block;
  text-decoration: none;
  color: #dce6df;
  margin: 8px 0;
  font-size: 14px;
}

.footer-links a:hover {
  color: white;
}

.footer-email {
  color: white;
  text-decoration: none;
  font-weight: bold;
}

.footer-bottom {
  max-width: 1100px;
  margin: 35px auto 0;
  padding-top: 20px;
  border-top: 1px solid rgba(255,255,255,.2);
  text-align: center;
  font-size: 12px;
  color: #cbd8cf;
}


/* =========================
   MOBILE
========================= */

@media (max-width: 900px) {

  .nav-links {
    display: none;
  }

  .options,
  .more-options {
    grid-template-columns: 1fr;
  }

  .footer-container {
    grid-template-columns: 1fr;
  }

}

</style>
</head>


